{
  "openapi": "3.1.0",
  "info": {
    "title": "Luanti Education Platform",
    "description": "Interface of the LEP backend for the web frontend and the worlds.",
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    },
    "version": "1"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [],
        "summary": "Says whether the backend can do its work, and nothing else: everybody\nmay ask. The details are for teachers, under `/api/web/v1/status`.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "State of the backend",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/web/v1/confirm": {
      "post": {
        "tags": [
          "web_api"
        ],
        "summary": "Confirms the address a teacher entered at the desk, with the token\nfrom the confirmation mail. A token works once.",
        "operationId": "confirm",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The address is confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Confirmed"
                }
              }
            }
          },
          "400": {
            "description": "The token is unknown, used or too old (invalid_token), or the request cannot be read (invalid_request)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "The address belongs to another account (address_taken)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/web/v1/login": {
      "post": {
        "tags": [
          "web_api"
        ],
        "summary": "Logs a teacher in with the token from a login mail and sets the\nsession cookie. A token works once.",
        "operationId": "log_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Logged in, the session cookie is set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "description": "The token is unknown, used or too old (invalid_token), or the request cannot be read (invalid_request)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/web/v1/login/link": {
      "post": {
        "tags": [
          "web_api"
        ],
        "summary": "Sends a mail with a login link to an address, if a teacher may log in\nwith it. The answer is the same in every case, so nobody learns here\nwhich addresses are known.",
        "operationId": "request_login_link",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginLinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Taken note of, whether or not a mail goes out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Done"
                }
              }
            }
          },
          "400": {
            "description": "The request cannot be read (invalid_request)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/web/v1/logout": {
      "post": {
        "tags": [
          "web_api"
        ],
        "summary": "Ends the session of the request and removes the cookie. Without a\nsession nothing happens.",
        "operationId": "log_out",
        "responses": {
          "200": {
            "description": "Logged out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Done"
                }
              }
            }
          }
        }
      }
    },
    "/api/web/v1/me": {
      "get": {
        "tags": [
          "web_api"
        ],
        "summary": "Says who is logged in.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The teacher of this session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in (unauthorized)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/web/v1/status": {
      "get": {
        "tags": [
          "web_api"
        ],
        "summary": "Says how the backend is doing, with the details that are nobody\nelse's business.",
        "operationId": "status",
        "responses": {
          "200": {
            "description": "State of the backend",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "401": {
            "description": "Not logged in (unauthorized)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/world/v1/events": {
      "post": {
        "tags": [
          "world_api"
        ],
        "summary": "Takes in events of a world. Every event is handled once, however often\nit is sent.",
        "operationId": "send_events",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "One result per event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventBatchResult"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Too many events in one request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "world_key": []
          }
        ]
      }
    },
    "/api/world/v1/jobs": {
      "get": {
        "tags": [
          "world_api"
        ],
        "summary": "Returns the jobs that wait for a world. If there are none, the request\nstays open for up to `wait` seconds and returns as soon as one comes.",
        "operationId": "fetch_jobs",
        "parameters": [
          {
            "name": "wait",
            "in": "query",
            "description": "Seconds to wait, at most 25",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The waiting jobs, possibly none",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "world_key": []
          }
        ]
      }
    },
    "/api/world/v1/jobs/{id}/result": {
      "post": {
        "tags": [
          "world_api"
        ],
        "summary": "Notes how a job went.",
        "operationId": "report_result",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the job",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobResult"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Noted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Done"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "The world has no such job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "world_key": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "Answer to a request that failed.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "What went wrong, in English, for logs and developers. It is not\nshown to users."
          }
        }
      },
      "ConfirmRequest": {
        "type": "object",
        "description": "Request to confirm an address with the token from a mail.",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "Confirmed": {
        "type": "object",
        "description": "Answer to a confirmed address.",
        "required": [
          "account"
        ],
        "properties": {
          "account": {
            "type": "string",
            "description": "Account name of the teacher the address now belongs to."
          }
        }
      },
      "Done": {
        "type": "object",
        "description": "Answer to a request that needs nothing said."
      },
      "ErrorCode": {
        "type": "string",
        "description": "Why a request failed, as a fixed word. The frontend translates it into\nthe language of the user.",
        "enum": [
          "unauthorized",
          "not_found",
          "too_large",
          "invalid_request",
          "invalid_token",
          "address_taken",
          "internal"
        ]
      },
      "Event": {
        "type": "object",
        "description": "One thing that happened in a world.",
        "required": [
          "id",
          "kind",
          "time",
          "payload"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique id, made up by the world. The backend uses it to notice\nan event it has seen before."
          },
          "kind": {
            "type": "string",
            "description": "What happened, for example \"world_started\". It decides what\nthe payload has to look like."
          },
          "payload": {
            "type": "object",
            "description": "The details, depending on the kind."
          },
          "time": {
            "type": "integer",
            "format": "int64",
            "description": "When it happened, in seconds since 1970 (UTC)."
          }
        }
      },
      "EventBatch": {
        "type": "object",
        "description": "Several events in one request, oldest first.",
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        }
      },
      "EventBatchResult": {
        "type": "object",
        "description": "Answer to a batch: one result per event, in the same order.",
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventResult"
            }
          }
        }
      },
      "EventOutcome": {
        "type": "string",
        "description": "What the backend did with an event. In every case the world may\nforget the event: sending it again would change nothing.",
        "enum": [
          "accepted",
          "duplicate",
          "unknown",
          "invalid"
        ]
      },
      "EventResult": {
        "type": "object",
        "description": "The outcome for one event of a batch.",
        "required": [
          "id",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/EventOutcome"
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Answer of the health check. Everybody may ask, so it says nothing\nbut whether the backend can do its work.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "description": "Whether the backend can do its work.",
        "enum": [
          "ok",
          "degraded"
        ]
      },
      "Job": {
        "type": "object",
        "description": "Something the backend wants a world to do.",
        "required": [
          "id",
          "kind",
          "payload"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "What to do, for example \"ping\". It decides what the payload has\nto look like."
          },
          "payload": {
            "type": "object"
          }
        }
      },
      "JobList": {
        "type": "object",
        "description": "The jobs that wait for a world. Empty if none came in time.",
        "required": [
          "jobs"
        ],
        "properties": {
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          }
        }
      },
      "JobResult": {
        "type": "object",
        "description": "How a job went.",
        "required": [
          "ok"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "A short note, for example why it failed."
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "Level": {
        "type": "object",
        "description": "One level of a module: its workload.",
        "required": [
          "stage"
        ],
        "properties": {
          "stage": {
            "type": "boolean",
            "description": "True if completing this level ends a stage of the module."
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskType"
            }
          }
        }
      },
      "LoginLinkRequest": {
        "type": "object",
        "description": "Request for a mail with a link that logs in.",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "The confirmed address of the teacher."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "Request to log in with the token from a mail.",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "MailTransport": {
        "type": "string",
        "description": "How mails leave the backend.",
        "enum": [
          "smtp",
          "terminal"
        ]
      },
      "Me": {
        "type": "object",
        "description": "The teacher who is logged in.",
        "required": [
          "account",
          "email",
          "worlds",
          "expires_at"
        ],
        "properties": {
          "account": {
            "type": "string",
            "description": "Account name of the teacher."
          },
          "email": {
            "type": "string",
            "description": "The confirmed address of the teacher."
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "description": "When the session ends, in seconds since 1970 (UTC)."
          },
          "worlds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Names of the worlds in which the teacher holds the privilege\nfor web access."
          }
        }
      },
      "Module": {
        "type": "object",
        "description": "A learning module as a world knows it.",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "levels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Level"
            }
          },
          "title": {
            "type": "string",
            "description": "Name for people, in the language of the world."
          }
        }
      },
      "Modules": {
        "type": "object",
        "description": "Payload of the event \"modules\": all modules of the world. It\nreplaces what the backend knew before.",
        "properties": {
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Module"
            }
          }
        }
      },
      "Progress": {
        "type": "object",
        "description": "Payload of the event \"progress\": where one student stands in one\nmodule. It is the whole state, not a change, and replaces what the\nbackend knew before.",
        "required": [
          "account",
          "module",
          "level",
          "locked",
          "percent",
          "completed"
        ],
        "properties": {
          "account": {
            "type": "string",
            "description": "Account name of the student."
          },
          "completed": {
            "type": "boolean",
            "description": "True if the whole module is completed."
          },
          "level": {
            "type": "integer",
            "format": "int32",
            "description": "Current level, counted from 1.",
            "minimum": 0
          },
          "locked": {
            "type": "boolean",
            "description": "True if moving up after a completed level is locked."
          },
          "module": {
            "type": "string"
          },
          "percent": {
            "type": "integer",
            "format": "int32",
            "description": "Share of the workload of the level that is done, 0 to 100.",
            "minimum": 0
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskProgress"
            },
            "description": "The kinds of tasks of the current level."
          }
        }
      },
      "ProtocolEntry": {
        "type": "object",
        "description": "Payload of the event \"protocol\": one entry of one of the protocols\nof a world. The time is the time of the event.",
        "required": [
          "protocol",
          "account"
        ],
        "properties": {
          "account": {
            "type": "string",
            "description": "Account name of the player the entry is about. Never a display\nname."
          },
          "fields": {
            "type": "object",
            "description": "The other columns of the entry, by name.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "protocol": {
            "type": "string",
            "description": "Which protocol, one of `PROTOCOLS`."
          }
        }
      },
      "Status": {
        "type": "object",
        "description": "State of the backend with its details, for teachers who are\nlogged in.",
        "required": [
          "status",
          "version",
          "mail"
        ],
        "properties": {
          "mail": {
            "$ref": "#/components/schemas/MailTransport"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string",
            "description": "Version of the backend, as in its package."
          }
        }
      },
      "TaskProgress": {
        "type": "object",
        "description": "How far a student is with one kind of task of their level.",
        "required": [
          "id",
          "solved",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "required": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "solved": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "TaskType": {
        "type": "object",
        "description": "A kind of task of a level, with how often it has to be solved.",
        "required": [
          "id",
          "title",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "required": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Name for people, in the language of the world."
          }
        }
      },
      "Teachers": {
        "type": "object",
        "description": "Payload of the event \"teachers\": the accounts that hold the\nprivilege for web access in this world. It replaces what the\nbackend knew before.",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Trophies": {
        "type": "object",
        "description": "Payload of the event \"trophies\": all trophies of one student. It\nreplaces what the backend knew before.",
        "required": [
          "account"
        ],
        "properties": {
          "account": {
            "type": "string"
          },
          "trophies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Trophy"
            }
          }
        }
      },
      "Trophy": {
        "type": "object",
        "description": "A trophy a student has earned.",
        "required": [
          "id",
          "title",
          "material"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "material": {
            "type": "string",
            "description": "\"bronze\", \"silver\" or \"gold\"."
          },
          "title": {
            "type": "string",
            "description": "Name for people, in the language of the world."
          }
        }
      },
      "WebAccessAction": {
        "type": "string",
        "description": "What a teacher can do with their web access at the desk.",
        "enum": [
          "set",
          "resend",
          "remove"
        ]
      },
      "WebAccessRequest": {
        "type": "object",
        "description": "Payload of the event \"web_access\": what a teacher did with their\nweb access.",
        "required": [
          "account",
          "action"
        ],
        "properties": {
          "account": {
            "type": "string",
            "description": "Account name of the teacher."
          },
          "action": {
            "$ref": "#/components/schemas/WebAccessAction"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "The address, for the action \"set\" only."
          }
        }
      },
      "WebAccessStatus": {
        "type": "object",
        "description": "Payload of the job \"web_access_status\": how the web access of a\nteacher stands. Addresses are shortened, the world never gets a\nwhole one back.",
        "required": [
          "account"
        ],
        "properties": {
          "account": {
            "type": "string",
            "description": "Account name of the teacher."
          },
