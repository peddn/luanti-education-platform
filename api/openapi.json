{
  "openapi": "3.1.0",
  "info": {
    "title": "Luanti Education Platform",
    "description": "Interface of the LEP backend for the web frontend and the worlds.",
    "license": {
      "name": "AGPL-3.0-or-later",
      "identifier": "AGPL-3.0-or-later"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [],
        "summary": "Says whether the backend can do its work.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "State of the backend",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/world/v1/events": {
      "post": {
        "tags": [
          "world_api"
        ],
        "summary": "Takes in events of a world. Every event is handled once, however often\nit is sent.",
        "operationId": "send_events",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "One result per event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventBatchResult"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "Too many events in one request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "world_key": []
          }
        ]
      }
    },
    "/api/world/v1/jobs": {
      "get": {
        "tags": [
          "world_api"
        ],
        "summary": "Returns the jobs that wait for a world. If there are none, the request\nstays open for up to `wait` seconds and returns as soon as one comes.",
        "operationId": "fetch_jobs",
        "parameters": [
          {
            "name": "wait",
            "in": "query",
            "description": "Seconds to wait, at most 25",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The waiting jobs, possibly none",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "world_key": []
          }
        ]
      }
    },
    "/api/world/v1/jobs/{id}/result": {
      "post": {
        "tags": [
          "world_api"
        ],
        "summary": "Notes how a job went.",
        "operationId": "report_result",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the job",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobResult"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Noted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Done"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "The world has no such job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "world_key": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "Answer to a request that failed.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "What went wrong, for people."
          }
        }
      },
      "Done": {
        "type": "object",
        "description": "Answer to a request that needs nothing said."
      },
      "Event": {
        "type": "object",
        "description": "One thing that happened in a world.",
        "required": [
          "id",
          "kind",
          "time",
          "payload"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique id, made up by the world. The backend uses it to notice\nan event it has seen before."
          },
          "kind": {
            "type": "string",
            "description": "What happened, for example \"world_started\". It decides what\nthe payload has to look like."
          },
          "payload": {
            "type": "object",
            "description": "The details, depending on the kind."
          },
          "time": {
            "type": "integer",
            "format": "int64",
            "description": "When it happened, in seconds since 1970 (UTC)."
          }
        }
      },
      "EventBatch": {
        "type": "object",
        "description": "Several events in one request, oldest first.",
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        }
      },
      "EventBatchResult": {
        "type": "object",
        "description": "Answer to a batch: one result per event, in the same order.",
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventResult"
            }
          }
        }
      },
      "EventOutcome": {
        "type": "string",
        "description": "What the backend did with an event. In every case the world may\nforget the event: sending it again would change nothing.",
        "enum": [
          "accepted",
          "duplicate",
          "unknown",
          "invalid"
        ]
      },
      "EventResult": {
        "type": "object",
        "description": "The outcome for one event of a batch.",
        "required": [
          "id",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/EventOutcome"
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Answer of the health check.",
        "required": [
          "status",
          "version",
          "database"
        ],
        "properties": {
          "database": {
            "type": "boolean",
            "description": "True if the database answers."
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string",
            "description": "Version of the backend, as in its package."
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "description": "Whether the backend can do its work.",
        "enum": [
          "ok",
          "degraded"
        ]
      },
      "Job": {
        "type": "object",
        "description": "Something the backend wants a world to do.",
        "required": [
          "id",
          "kind",
          "payload"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "What to do, for example \"ping\". It decides what the payload has\nto look like."
          },
          "payload": {
            "type": "object"
          }
        }
      },
      "JobList": {
        "type": "object",
        "description": "The jobs that wait for a world. Empty if none came in time.",
        "required": [
          "jobs"
        ],
        "properties": {
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          }
        }
      },
      "JobResult": {
        "type": "object",
        "description": "How a job went.",
        "required": [
          "ok"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "A short note, for example why it failed."
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "Level": {
        "type": "object",
        "description": "One level of a module: its workload.",
        "required": [
          "stage"
        ],
        "properties": {
          "stage": {
            "type": "boolean",
            "description": "True if completing this level ends a stage of the module."
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskType"
            }
          }
        }
      },
      "Module": {
        "type": "object",
        "description": "A learning module as a world knows it.",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "levels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Level"
            }
          },
          "title": {
            "type": "string",
            "description": "Name for people, in the language of the world."
          }
        }
      },
      "Modules": {
        "type": "object",
        "description": "Payload of the event \"modules\": all modules of the world. It\nreplaces what the backend knew before.",
        "properties": {
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Module"
            }
          }
        }
      },
      "Progress": {
        "type": "object",
        "description": "Payload of the event \"progress\": where one student stands in one\nmodule. It is the whole state, not a change, and replaces what the\nbackend knew before.",
        "required": [
          "account",
          "module",
          "level",
          "locked",
          "percent",
          "completed"
        ],
        "properties": {
          "account": {
            "type": "string",
            "description": "Account name of the student."
          },
          "completed": {
            "type": "boolean",
            "description": "True if the whole module is completed."
          },
          "level": {
            "type": "integer",
            "format": "int32",
            "description": "Current level, counted from 1.",
            "minimum": 0
          },
          "locked": {
            "type": "boolean",
            "description": "True if moving up after a completed level is locked."
          },
          "module": {
            "type": "string"
          },
          "percent": {
            "type": "integer",
            "format": "int32",
            "description": "Share of the workload of the level that is done, 0 to 100.",
            "minimum": 0
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskProgress"
            },
            "description": "The kinds of tasks of the current level."
          }
        }
      },
      "ProtocolEntry": {
        "type": "object",
        "description": "Payload of the event \"protocol\": one entry of one of the protocols\nof a world. The time is the time of the event.",
        "required": [
          "protocol",
          "account"
        ],
        "properties": {
          "account": {
            "type": "string",
            "description": "Account name of the player the entry is about. Never a display\nname."
          },
          "fields": {
            "type": "object",
            "description": "The other columns of the entry, by name.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "protocol": {
            "type": "string",
            "description": "Which protocol, one of `PROTOCOLS`."
          }
        }
      },
      "TaskProgress": {
        "type": "object",
        "description": "How far a student is with one kind of task of their level.",
        "required": [
          "id",
          "solved",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "required": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "solved": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "TaskType": {
        "type": "object",
        "description": "A kind of task of a level, with how often it has to be solved.",
        "required": [
          "id",
          "title",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "required": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Name for people, in the language of the world."
          }
        }
      },
      "Trophies": {
        "type": "object",
        "description": "Payload of the event \"trophies\": all trophies of one student. It\nreplaces what the backend knew before.",
        "required": [
          "account"
        ],
        "properties": {
          "account": {
            "type": "string"
          },
          "trophies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Trophy"
            }
          }
        }
      },
      "Trophy": {
        "type": "object",
        "description": "A trophy a student has earned.",
        "required": [
          "id",
          "title",
          "material"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "material": {
            "type": "string",
            "description": "\"bronze\", \"silver\" or \"gold\"."
          },
          "title": {
            "type": "string",
            "description": "Name for people, in the language of the world."
          }
        }
      },
      "WorldStarted": {
        "type": "object",
        "description": "Payload of the event \"world_started\".",
        "required": [
          "engine",
          "mods"
        ],
        "properties": {
          "engine": {
            "type": "string",
            "description": "Version of the game engine, as it names itself."
          },
          "mods": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Names of the mods that are loaded."
          }
        }
      }
    },
    "securitySchemes": {
      "world_key": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
