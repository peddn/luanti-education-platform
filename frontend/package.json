{
  "name": "lep-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "types": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "types:check": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts --check",
    "typecheck": "vue-tsc --noEmit -p jsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
