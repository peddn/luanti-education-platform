# Settings of the LEP agent. Goes to /etc/lep/agent.toml, owned by the
# user lep and readable for nobody else (mode 600): it holds the key.

# Address of the backend. It must start with https://, because the key
# travels with every request. Only a backend on the same machine may be
# reached with http://.
backend = "http://127.0.0.1:8080"

# The key from: lep-backend agent key
key = "lepa_..."

# Folder for everything the agent touches.
data_dir = "/var/lib/lep"

# Account name of the server admin. The agent enters it into every world
# it creates, so a new world has a first way in. Without it the agent
# creates no worlds. 1 to 19 characters: letters, digits, - and _.
admin = "admin"

# Ports the worlds get, first and last. The firewall must let UDP
# through for all of them.
ports = "30000-30099"

# Name or address under which players reach this machine, without a
# port. With the port of a world it makes the address that is printed on
# the access slips, like "spiel.schule.example, Port 30000". Without it
# the school administration enters the address of every world by hand.
host = "spiel.schule.example"

# The Luanti server the worlds run with. scripts/luanti-build.sh and
# "sudo cmake --install target/luanti/build" put it here.
luanti = "/usr/local/bin/luantiserver"
