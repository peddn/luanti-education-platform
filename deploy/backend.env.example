# Settings of the LEP backend. Goes to /etc/lep/backend.env, owned by
# root, readable for the group lep-backend only (mode 640).
# One NAME=value per line, without quotes.

# Address the backend listens on. 127.0.0.1 if a web server with a
# certificate stands in front of it, 0.0.0.0 to try it out in the own
# network without one.
LEP_BIND=127.0.0.1:8080

# Address of the web application as browsers reach it. Links in mails
# start with it.
LEP_PUBLIC_URL=https://lep.schule.example

LEP_DATABASE=/var/lib/lep-backend/lep.sqlite
LEP_FRONTEND=/usr/local/share/lep/frontend

# Mail server. Without LEP_SMTP_HOST the mails are written to the log of
# the service instead of being sent.
#LEP_SMTP_HOST=mail.schule.example
#LEP_SMTP_PORT=587
#LEP_SMTP_SECURITY=starttls
#LEP_SMTP_USER=lep@schule.example
#LEP_SMTP_PASSWORD=
#LEP_MAIL_FROM=LEP <lep@schule.example>
